rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownUserDoc(userId) { return signedIn() && request.auth.uid == userId; }
    function teacherApproved() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved';
    }
    match /users/{userId} {
      allow get: if ownUserDoc(userId) || teacherApproved();
      allow list: if teacherApproved();
      allow create: if ownUserDoc(userId)
        && request.resource.data.keys().hasAll(['name','mobile','role','status','createdAt','updatedAt'])
        && request.resource.data.keys().hasOnly(['name','mobile','role','status','createdAt','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.mobile is string
        && request.resource.data.mobile.matches('^[6-9][0-9]{9}$')
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if teacherApproved()
        || (ownUserDoc(userId)
          && resource.data.role == 'student'
          && request.resource.data.role == resource.data.role
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','updatedAt']));
      allow delete: if teacherApproved();
    }
    // New data collections receive explicit student-owner rules when each module is built.
    match /{document=**} { allow read, write: if teacherApproved(); }
  }
}
